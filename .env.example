# 环境变量配置文件
# 复制此文件为 .env 并根据需要修改

# 数据库配置
DATABASE_URL=sqlite:////app/data/monitor.db

# 生产环境建议使用PostgreSQL
# DATABASE_URL=postgresql://admin:password123@postgres:5432/servertracker

# 后端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# 前端配置
FRONTEND_PORT=80

# 探针配置
PROBE_INTERVAL=60
PROBE_TIMEOUT=10

# 安全配置
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost,http://localhost:80

# 日志级别
LOG_LEVEL=INFO

# Redis配置 (可选，用于缓存)
# REDIS_URL=redis://redis:6379/0

# SMTP配置 (可选，用于邮件告警)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true